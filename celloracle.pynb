   ],
   "source": [
    "networks = {}\n",
    "for label, oracle in oracles.items():\n",
    "    networks[label] = oracle.get_links(\n",
    "        cluster_name_for_GRN_unit=\"seurat_clusters\",\n",
    "        alpha=10,\n",
    "        bagging_number=20,\n",
    "        model_method=\"bagging_ridge\",\n",
    "        verbose_level=10,\n",
    "        n_jobs=4,\n",
    "    )\n",
    "    assert set(map(str, networks[label].links_dict)) == {\"6\", \"9\"}\n",
    "    for cluster, edges in networks[label].links_dict.items():\n",
    "        print(label, \"cluster\", cluster, \"unfiltered edges:\", len(edges))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "557c2cc6",
   "metadata": {},
   "outputs": [],
   "source": [
    "#https://morris-lab.github.io/CellOracle.documentation/notebooks/04_Network_analysis/Network_analysis_with_Paul_etal_2015_data.html#6.-Network-preprocessing\n",
    "# Keep up to 2000 strong connections per WT cluster\n",
    "networks[\"WT\"].filter_links(\n",
    "    p=0.001,\n",
    "    weight=\"coef_abs\",\n",
    "    threshold_number=2000\n",
    ")\n",
    "\n",
    "# Keep up to 2000 strong connections per mutant cluster\n",
    "networks[\"Mutant\"].filter_links(\n",
    "    p=0.001,\n",
    "    weight=\"coef_abs\",\n",
    "    threshold_number=2000\n",
    ")"
   ]
  },
