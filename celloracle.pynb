   "source": [
    "base_GRN = co.data.load_xenopus_tropicalis_promoter_base_GRN(\n",
    "    version=\"xenTro3_CisBPv2_fpr2\"\n",
    ")\n",
    "display(base_GRN.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "33b00061",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WT: (362, 2000)\n",
      "Mutant: (450, 2000)\n"
     ]
    }
   ],
   "source": [
    "# Combine WT and mutant/delete genes so cell oracle can run \n",
    "pooled = sc.concat([wt_adata, mutant_adata]).copy()\n",
    "\n",
    "# Remove genes detected in fewer than 10 cells\n",
    "sc.pp.filter_genes(pooled, min_cells=10)\n",
    "\n",
    "# Select approximately 2000 variable genes\n",
    "sc.pp.highly_variable_genes(\n",
    "    pooled,\n",
    "    flavor=\"seurat\",\n",
    "    n_top_genes=2000,\n",
    "    subset=True\n",
    ")\n",
    "\n",
    "# Keep the selected genes in both datasets\n",
    "wt_adata = wt_adata[:, pooled.var_names].copy()\n",
    "mutant_adata = mutant_adata[:, pooled.var_names].copy()\n",
    "\n",
    "print(\"WT:\", wt_adata.shape)\n",
    "print(\"Mutant:\", mutant_adata.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "55b61cd0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WT: (362, 2000)\n",
      "Mutant: (450, 2000)\n"
     ]
    }
   ],
   "source": [
    "# Store cluster labels as categories for CellOracle\n",
    "wt_adata.obs[\"seurat_clusters\"] = wt_adata.obs[\"seurat_clusters\"].astype(\"category\")\n",
    "\n",
    "mutant_adata.obs[\"seurat_clusters\"] = mutant_adata.obs[\"seurat_clusters\"].astype(\"category\")\n",
    "\n",
    "# Organize the datasets for the following cells\n",
    "datasets = {\n",
    "    \"WT\": wt_adata,\n",
    "    \"Mutant\": mutant_adata\n",
    "}\n",
    "\n",
    "print(\"WT:\", wt_adata.shape)\n",
    "print(\"Mutant:\", mutant_adata.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d6816b20",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "... storing 'orig.ident' as categorical\n",
      "... storing 'orig.ident' as categorical\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WT import complete\n",
      "Mutant import complete\n"
     ]
    }
   ],
   "source": [
    "# CellOracle: create an Oracle object and import the base GRN\n",
    "# https://morris-lab.github.io/CellOracle.documentation/notebooks/04_Network_analysis/Network_analysis_with_Paul_etal_2015_data.html#2.-Make-Oracle-object\n",
    "\n",
    "# CellOracle: import already log-normalized, unscaled expression\n",
    "# https://morris-lab.github.io/CellOracle.documentation/modules/celloracle.html#celloracle.Oracle.import_anndata_as_normalized_count\n",
    "\n",
    "oracles = {}\n",
    "\n",
    "for label, adata in datasets.items():\n",
    "\n",
    "    # Create a container for this dataset\n",
    "    oracle = co.Oracle()\n",
    "\n",
    "    # Import expression, cluster labels and UMAP coordinates\n",
    "    oracle.import_anndata_as_normalized_count(\n",
    "        adata=adata,\n",
    "        cluster_column_name=\"seurat_clusters\",\n",
    "        embedding_name=\"X_umap\",\n",
    "        test_mode=True\n",
    "    )\n",
    "\n",
    "    # Set cluster colors using CellOracle's public method\n",
    "    # https://morris-lab.github.io/CellOracle.documentation/modules/celloracle.html#celloracle.Oracle.update_cluster_colors\n",
    "    oracle.update_cluster_colors(\n",
    "        palette={\"6\": \"#4477AA\", \"9\": \"#EE6677\"}\n",
    "    )\n",
    "\n",
    "    # Import possible TF-to-gene connections\n",
    "    oracle.import_TF_data(TF_info_matrix=base_GRN)\n",
    "\n",
    "    # Store the WT or mutant object\n",
    "    oracles[label] = oracle\n",
    "\n",
    "    print(label, \"import complete\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0f409aaa",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<function IPython.core.display_functions.display(*objs, include=None, exclude=None, metadata=None, transient=None, display_id=None, raw=False, clear=False, **kwargs)>"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Based on CellOracle's PCA and KNN tutorial:\n",
    "# https://morris-lab.github.io/CellOracle.documentation/notebooks/04_Network_analysis/Network_analysis_with_Paul_etal_2015_data.html#3.-KNN-imputation\n",
    "\n",
    "N_PCS = 20\n",
    "for label, oracle in oracles.items():\n",
    "    oracle.perform_PCA()\n",
    "    cumulative_variance = np.cumsum(oracle.pca.explained_variance_ratio_)\n",
    "    plt.figure(figsize=(5, 3))\n",
    "    plt.plot(np.arange(1, len(cumulative_variance) + 1), cumulative_variance)\n",
    "    plt.axvline(N_PCS, color=\"black\", linestyle=\"--\")\n",
    "    plt.xlabel(\"Number of PCs\")\n",
    "    plt.ylabel(\"Cumulative explained variance\")\n",
    "    plt.title(label)\n",
    "    plt.xlim(1, min(50, len(cumulative_variance)))\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "display"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "959e13e4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WT KNN complete. Neighbors: 9\n",
      "Mutant KNN complete. Neighbors: 11\n"
     ]
    }
   ],
   "source": [
    "#https://morris-lab.github.io/CellOracle.documentation/notebooks/04_Network_analysis/Network_analysis_with_Paul_etal_2015_data.html#3.-KNN-imputation\n",
    "for label, oracle in oracles.items():\n",
    "\n",
    "    # Count the cells in this dataset\n",
    "    n_cells = oracle.adata.shape[0]\n",
    "\n",
    "    # Use 2.5% of the cells as neighbors, as in the tutorial\n",
    "    k = int(0.025 * n_cells)\n",
    "\n",
    "    # Smooth expression using nearby cells in PCA space\n",
    "    oracle.knn_imputation(\n",
    "        n_pca_dims=N_PCS,\n",
    "        k=k,\n",
    "        balanced=True,\n",
    "        b_sight=k * 8,\n",
    "        b_maxl=k * 4,\n",
    "        n_jobs=4\n",
    "    )\n",
    "\n",
    "    print(label, \"KNN complete. Neighbors:\", k)"
   ]
  },
