   "source": [
    "#https://morris-lab.github.io/CellOracle.documentation/notebooks/04_Network_analysis/Network_analysis_with_Paul_etal_2015_data.html\n",
    "for label, links in networks.items():\n",
    "    if any(edges.empty for edges in links.filtered_links.values()):\n",
    "        print(label, \"has an empty filtered network; inspect it before calculating scores.\")\n",
    "        continue\n",
    "    links.get_network_score()\n",
    "    for cluster in [\"6\", \"9\"]:\n",
    "        scores = links.merged_score\n",
    "        selected = scores[scores[\"cluster\"].astype(str) == cluster]\n",
    "        print(label, \"cluster\", cluster, \"top genes by outgoing connections\")\n",
    "        display(selected[selected[\"degree_out\"] > 0].nlargest(10, \"degree_out\"))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "ee68d05e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WT\n",
      "6\n",
      "9\n",
      "Mutant\n",
      "6\n",
      "9\n"
     ]
    }
   ],
   "source": [
    "#see plots \n",
    "for label, links in networks.items():\n",
    "    if any(edges.empty for edges in links.filtered_links.values()):\n",
    "        continue\n",
    "    print(label)\n",
    "    links.plot_degree_distributions(plot_model=True)\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a24feb46",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Results saved in: /sfs/gpfs/tardis/home/ran3ds/CellOracle_student_results\n"
     ]
    }
   ],
   "source": [
    "#save results \n",
    "output_dir = Path(\"CellOracle_student_results\")\n",
    "output_dir.mkdir(exist_ok=True)\n",
    "\n",
    "for label, links in networks.items():\n",
    "    oracles[label].to_hdf5(str(output_dir / f\"{label}.celloracle.oracle\"))\n",
    "    links.to_hdf5(str(output_dir / f\"{label}.celloracle.links\"))\n",
    "    for cluster in [\"6\", \"9\"]:\n",
    "        links.links_dict[cluster].to_csv(\n",
    "            output_dir / f\"{label}_cluster{cluster}_unfiltered.csv\", index=False\n",
    "        )\n",
    "        links.filtered_links[cluster].to_csv(\n",
    "            output_dir / f\"{label}_cluster{cluster}_filtered.csv\", index=False\n",
    "        )\n",
    "    if links.merged_score is not None:\n",
    "        links.merged_score.to_csv(output_dir / f\"{label}_network_scores.csv\")\n",
    "\n",
    "pd.Series({\"python\": sys.version, \"celloracle\": co.__version__,\n",
    "           \"scanpy\": sc.__version__, \"requested_PCs\": N_PCS}).to_csv(\n",
    "    output_dir / \"analysis_settings.csv\", header=False\n",
    ")\n",
    "print(\"Results saved in:\", output_dir.resolve())\n"
   ]
  }
