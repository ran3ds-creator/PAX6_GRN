    }
   ],
   "source": [
    "practicedata.obs[\"seurat_clusters\"] = (\n",
    "    practicedata.obs[\"seurat_clusters\"].astype(str)\n",
    ")\n",
    "wt_adata = practicedata[\n",
    "    (practicedata.obs[\"orig.ident\"] == \"pax6_WT\") &\n",
    "    (practicedata.obs[\"seurat_clusters\"].isin([\"6\", \"9\"]))\n",
    "].copy()\n",
    "\n",
    "mutant_adata = practicedata[\n",
    "    (practicedata.obs[\"orig.ident\"] == \"pax6_Mutant\") &\n",
    "    (practicedata.obs[\"seurat_clusters\"].isin([\"6\", \"9\"]))\n",
    "].copy()\n",
    "print(\"WT:\", wt_adata.shape)\n",
    "print(\"Mutant:\", mutant_adata.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5a80d66d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#this is for scaling an nonegative \n",
    "wt_adata.X = wt_adata.raw[:, wt_adata.var_names].X.copy()\n",
    "mutant_adata.X = mutant_adata.raw[:, mutant_adata.var_names].X.copy()"
   ]
  },
